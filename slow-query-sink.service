[Unit]
Description=MySQL Slow Query Log Reconstruction Daemon
Documentation=https://github.com/DO-Solutions/slow-logs-custom-sync-pmm
After=rsyslog.service
Requires=rsyslog.service

[Service]
Type=simple
User=mysqlsink
Group=mysqlsink
SupplementaryGroups=adm
ExecStart=/usr/bin/python3 /var/log/mysql_sink/bin/transform_logs.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
# 0640 for anything the daemon creates (it recreates native_slow_query.log if a
# rotation removed it), keeping SQL text off-limits to other local users; group
# adm comes from the setgid processed/ directory (see setup.sh).
UMask=0027
# Where the daemon saves its place in the incoming log across restarts
# (STATE_FILE in transform_logs.py). systemd creates it owned by mysqlsink and
# keeps it writable under ProtectSystem=strict; 0700 because the saved
# in-flight blocks hold SQL text. A subdirectory, so that /var/lib/mysql_sink
# itself (root's, holding setup.sh's symlink record) stays root-owned.
StateDirectory=mysql_sink/slow-query-sink
StateDirectoryMode=0700

# Hardening — daemon only needs to read/write under /var/log/mysql_sink (plus
# its StateDirectory)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log/mysql_sink
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
MemoryMax=256M

[Install]
WantedBy=multi-user.target
